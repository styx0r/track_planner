# Copy to `.env` in this directory. Compose picks it up automatically.
# Everything has a default; PUBLIC_HOST is the one you really must set.

# Hostname or IP under which clients (browsers on phones/tablets/laptops)
# reach this machine. Baked into the frontends and used to sign MinIO
# download URLs. Changing it requires rebuilding the frontend images.
PUBLIC_HOST=192.168.178.50

# Which services `docker compose up` starts by default. Comma-separated.
# Options: all | backend | frontends | rehearsal | conductor | moderator |
#          mixing-desk | backoffice   (ArangoDB/MinIO always start)
# Leave empty/unset for infrastructure only.
COMPOSE_PROFILES=all

# Host ports
BACKEND_PORT=3333
BACKOFFICE_PORT=3000
REHEARSAL_PORT=3001
CONDUCTOR_PORT=3002
MODERATOR_PORT=3003
MIXING_DESK_PORT=3004
ARANGO_PORT=8529
MINIO_PORT=9000

# Conductor unlock PIN (baked into the conductor image at build time)
CONDUCTOR_PIN=1234

# Backoffice -> backend URL as seen from inside the backoffice container.
# Only change if the backend does NOT run in this compose project.
# BACKOFFICE_BACKEND_URL=http://host.docker.internal:3333

# ArangoDB
ARANGO_ROOT_PASSWORD=track_planner
ARANGO_DATABASE=track-planner
ARANGO_USER=track-planner
ARANGO_PASSWORD=track-planner

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION=eu-central-1
MINIO_BUCKET_NAME=music-files
