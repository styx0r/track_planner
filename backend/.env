# Minio Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=music-files

ARANGO_URL=http://localhost:8529
ARANGO_DATABASE=track-planner
ARANGO_USER=track-planner
ARANGO_PASSWORD=track-planner

MPV_PATH=C:\0_FASTDATA\mpv\mpv.exe
# Full path to ffmpeg.exe (server-side waveform generation). Adjust if needed.
FFMPEG_PATH=C:\0_FASTDATA\mpv\ffmpeg.exe

# CPU temperature source (LibreHardwareMonitor "Remote Web Server" JSON).
# Native Windows backend: 127.0.0.1. Backend inside Docker: host.docker.internal.
CPU_TEMP_URL=http://127.0.0.1:8085/data.json