ARANGO_URL=http://localhost:8529
ARANGO_DATABASE=your-database-name
ARANGO_USER=your-username
ARANGO_PASSWORD=your-password

# Minio Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=music-files

# Audio Player Configuration (Windows)
# Set the full path to mpv.exe if it's not in your system PATH
# Example: C:\Program Files\mpv\mpv.exe
# MPV_PATH=

# ffmpeg Configuration (Windows)
# Set the full path to ffmpeg.exe if it's not in your system PATH.
# Used for server-side waveform generation; without it the conductor waveform
# falls back to a dummy. Falls back to 'ffmpeg' on PATH when unset/not found.
# Example: C:\Program Files\ffmpeg\bin\ffmpeg.exe
# FFMPEG_PATH=
